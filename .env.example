# ─────────────────────────────────────────────────────────────
# Elistohub website – environment variables
#
# • VITE_SITE_URL is public (it's built into the website).
#   For the live build, set it in .env.production.
# • The Brevo values below are ONLY for local testing with `npm run dev`.
#   On BigRock they live in elistohub-config.php (see server/elistohub-config.example.php).
#
# Copy this file to .env.local and fill in the values. Never commit .env.local.
# ─────────────────────────────────────────────────────────────

# Brevo (local `npm run dev` only)
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=dev.elistohub@gmail.com
EMAIL_FROM_NAME=Elistohub
CONTACT_TO_EMAIL=dev.elistohub@gmail.com

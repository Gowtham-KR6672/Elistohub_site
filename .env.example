# ─────────────────────────────────────────────────────────────
# Elistohub website – environment variables
# Copy this file to .env.local and fill in the values.
# Never commit .env.local (it holds your secret API key).
# ─────────────────────────────────────────────────────────────

# Public URL of the site (used for SEO metadata, sitemap and robots.txt)
NEXT_PUBLIC_SITE_URL=https://elistohub.com

# ── Brevo (contact form emails) ──────────────────────────────
# Create a key in Brevo: Settings → SMTP & API → API keys
BREVO_API_KEY=

# Where new enquiries are delivered (comma-separate several addresses)
CONTACT_TO_EMAIL=hello@elistohub.com

# Sender for the emails. Must be a sender/domain verified in Brevo
# (Brevo → Senders, domains & dedicated IPs)
EMAIL_FROM_ADDRESS=no-reply@elistohub.com
EMAIL_FROM_NAME=Elistohub

# Optional: also save each enquiry as a Brevo contact in this list ID
# (Brevo → Contacts → Lists, the number in the ID column). Leave empty to skip.
BREVO_LIST_ID=

# Optional: send the visitor a "thanks, we got your message" email (true/false)
CONTACT_SEND_CONFIRMATION=false
